# Copy this file to `.env` (gitignored) and fill in your values.
# It is loaded automatically by `bin/run-op.js` (the CLI) and the web server — no `export` needed.

# Optional: Anthropic API key — an alternative to the `claude` CLI for LLM-written emails/transcripts.
# Not needed if you have the Claude Code CLI (it runs on your Claude subscription).
# Get one at https://console.anthropic.com  →  Settings → API Keys → Create Key.
# NOTE: API billing is SEPARATE from any Claude.ai / Claude Code subscription — add credits
# under Settings → Billing first. Starts with "sk-ant-". Uncomment and paste your key:
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: web server port (default 8787).
# PORT=8787
